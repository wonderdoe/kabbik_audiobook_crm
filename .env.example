# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_DATABASE=

# Redis environment: staging | production
REDIS_ENV=staging

# Redis staging (no TLS)
REDIS_STAGING_HOST=127.0.0.1
REDIS_STAGING_PORT=6379
REDIS_STAGING_PASSWORD=
REDIS_STAGING_DB=0

# Redis production (TLS — DigitalOcean managed Redis)
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=25061
REDIS_DB=0

# Cache: set to false to bypass Redis reads/writes (DB only)
CACHE_ENABLED=true

# USD → BDT for Stripe / Apple / Google SQL conversions (default: live rate via open.er-api.com, Redis TTL 1h)
# USD_BDT_RATE=122.68
# USD_BDT_FALLBACK=121.14
# USD_BDT_CACHE_TTL_SECONDS=3600
# USD_BDT_API_URL=https://open.er-api.com/v6/latest/USD

# Cron HTTP triggers (Phase 4+)
CRON_SECRET=

JWT_ACCESS_SECRET=

# Maintenance flag (DigitalOcean Spaces kabbik-space — CRM write only; see docs/maintenance/infra.md)
MAINTENANCE_BUCKET=kabbik-space
MAINTENANCE_REGION=sgp1
MAINTENANCE_WRITE_KEY_ID=
MAINTENANCE_WRITE_SECRET=
# CDN base (origin or CDN host OK — CRM rewrites origin to cdn for client URLs)
MAINTENANCE_PUBLIC_BASE_URL=https://kabbik-space.sgp1.cdn.digitaloceanspaces.com
MAINTENANCE_KEY_PREFIX=kabbik-maintenance
# Optional: override auto endpoint https://<MAINTENANCE_REGION>.digitaloceanspaces.com
# MAINTENANCE_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# MAINTENANCE_FORCE_PATH_STYLE=false
# Optional: strict If-Match concurrency (default on; Spaces may need retry — see MAINTENANCE_ETAG_CHECKS)
# MAINTENANCE_ETAG_CHECKS=true